FROM python:3.10-slim

WORKDIR /app

# Install system dependencies including Chrome
RUN apt-get update -qq -y && \
    apt-get install -y \
        gcc \
        g++ \
        gfortran \
        libportaudio2 \
        portaudio19-dev \
        ffmpeg \
        libavcodec-dev \
        libavformat-dev \
        libavutil-dev \
        wget \
        unzip \
        gnupg2 \
        curl \
        libasound2 \
        libatk-bridge2.0-0 \
        libgtk-4-1 \
        libnss3 \
        libxss1 \
        libgconf-2-4 \
        libxrandr2 \
        libasound2 \
        libpangocairo-1.0-0 \
        libatk1.0-0 \
        libcairo-gobject2 \
        libgtk-3-0 \
        libgdk-pixbuf2.0-0 \
        xdg-utils \
        && rm -rf /var/lib/apt/lists/*

# Install Google Chrome
RUN wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | apt-key add - && \
    echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google-chrome.list && \
    apt-get update -qq -y && \
    apt-get install -y google-chrome-stable && \
    rm -rf /var/lib/apt/lists/*

# Install ChromeDriver - Use Chrome for Testing API for compatible version
RUN CHROME_VERSION=$(google-chrome --version | awk '{print $3}' | cut -d'.' -f1-3) && \
    echo "Detected Chrome version: $CHROME_VERSION" && \
    CHROME_MAJOR=$(echo $CHROME_VERSION | cut -d'.' -f1) && \
    echo "Chrome major version: $CHROME_MAJOR" && \
    CHROMEDRIVER_VERSION=$(curl -s "https://googlechromelabs.github.io/chrome-for-testing/LATEST_RELEASE_$CHROME_MAJOR" 2>/dev/null || echo "fallback") && \
    if [ "$CHROMEDRIVER_VERSION" = "fallback" ] || [ -z "$CHROMEDRIVER_VERSION" ]; then \
        echo "Using fallback ChromeDriver installation method" && \
        apt-get update && apt-get install -y chromium-driver && \
        ln -sf /usr/bin/chromedriver /usr/local/bin/chromedriver; \
    else \
        echo "Using ChromeDriver version: $CHROMEDRIVER_VERSION" && \
        wget -O /tmp/chromedriver.zip "https://storage.googleapis.com/chrome-for-testing-public/$CHROMEDRIVER_VERSION/linux64/chromedriver-linux64.zip" && \
        unzip /tmp/chromedriver.zip -d /tmp/ && \
        mv /tmp/chromedriver-linux64/chromedriver /usr/local/bin/chromedriver && \
        chmod +x /usr/local/bin/chromedriver && \
        rm -rf /tmp/chromedriver.zip /tmp/chromedriver-linux64; \
    fi && \
    chromedriver --version || echo "ChromeDriver installed but version check failed - continuing anyway"

# Create directories for volumes
RUN mkdir -p /app/workdir /app/logs /app/config /app/.screenshots

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY api.py .
COPY sources/ ./sources/
COPY prompts/ ./prompts/
COPY crx/ ./crx/
COPY llm_router/ ./llm_router/
COPY config.ini ./config.ini

# Create non-root user for security
RUN useradd -m -u 1000 agenticseek && \
    chown -R agenticseek:agenticseek /app
USER agenticseek

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["python3", "api.py"]
